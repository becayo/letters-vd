---
import Layout from '@/layouts/Layout.astro';
import { db } from '@/db/client';
import { letters } from '@/db/schema';
import { desc } from 'drizzle-orm';

const allLetters = await db.select().from(letters).orderBy(desc(letters.createdAt));

function formatDate(dateStr: string) {
  // dateStr está en formato "YYYY-MM-DD HH:mm:ss" (Zona Horaria Santiago, Chile)
  const parts = dateStr.split(' ')[0].split('-');
  const year = parseInt(parts[0]);
  const month = parseInt(parts[1]) - 1; // Mes en JS es base-0
  const day = parseInt(parts[2]);

  const date = new Date(year, month, day);

  return date.toLocaleDateString('es-CL', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });
}
---

<Layout>
  <main class="max-w-lg mx-auto px-4 py-10">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="font-['Lora'] text-2xl font-medium text-stone-800">Cartas</h1>
        <p class="font-['Caveat'] text-stone-500 text-lg mt-0.5">V D & B C</p>
      </div>
      <a
        href="/write"
        class="flex items-center gap-2 bg-stone-800 text-amber-50 font-['Caveat'] text-lg px-4 py-2 rounded-2xl hover:bg-stone-700 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
        </svg>
        Escribir
      </a>
    </div>

    <!-- Estado vacío -->
    {allLetters.length === 0 ? (
      <div class="text-center py-24">
        <div class="text-6xl mb-4">✉️</div>
        <p class="font-['Caveat'] text-stone-500 text-xl">Aún no hay cartas...</p>
        <p class="font-['Caveat'] text-stone-400 text-lg mt-1">¡Sé el primero en escribir una!</p>
      </div>
    ) : (
      <!-- Grilla de cartas -->
      <div class="grid grid-cols-2 gap-4">
        {allLetters.map((letter, i) => (
          <a
            href={`/carta/${letter.id}`}
            class="group block bg-white border border-stone-200 rounded-2xl p-4 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200"
          >
            <!-- Número y fecha -->
            <div class="mb-3">
              <span class="font-['Caveat'] text-stone-400 text-sm">Carta {allLetters.length - i}</span>
              <p class="font-['Caveat'] text-stone-500 text-sm leading-tight">{formatDate(letter.createdAt)}</p>
            </div>

            <!-- Línea decorativa con color de tinta -->
            <div class="w-8 h-0.5 rounded-full mb-3" style={`background-color: ${letter.inkColor}`}></div>

            <!-- De / Para -->
            <div class="space-y-0.5">
              <p class="font-['Caveat'] text-stone-600 text-base leading-tight">
                <span class="text-stone-400">De:</span> {letter.fromName}
              </p>
              <p class="font-['Caveat'] text-stone-600 text-base leading-tight">
                <span class="text-stone-400">Para:</span> {letter.toName}
              </p>
            </div>

            <!-- Ícono de sobre al hover -->
            <div class="mt-3 flex justify-end opacity-0 group-hover:opacity-100 transition-opacity">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-stone-400" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    )}
  </main>
</Layout>
